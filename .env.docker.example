# Optional overrides for `docker compose up`.
# Copy to `.env` next to docker-compose.yml and edit.
# DATABASE_URL and REDIS_URL are NOT here — they are hardcoded in
# docker-compose.yml to point at the postgres and redis service names.

GITHUB_WEBHOOK_SECRET=replace-me
RUN_SEED=true

# Real-adapter config (only needed when *_ADAPTER_MODE=real)
JIRA_BASE_URL="https://your-team.atlassian.net"
JIRA_EMAIL="you@example.com"
JIRA_API_TOKEN="replace-me"
SLACK_BOT_TOKEN="xoxb-replace-me"
SLACK_DEFAULT_CHANNEL="#dev-notifications"
